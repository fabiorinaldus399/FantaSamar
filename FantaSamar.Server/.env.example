# Copia questo file in ".env" e valorizza le variabili per il tuo ambiente.
# Il file ".env" NON va mai committato (è escluso da .gitignore).

# Porta su cui il backend si mette in ascolto
PORT=3000

# Chiave segreta usata per firmare i JWT: cambiala sempre in produzione!
JWT_SECRET=una-chiave-segreta-lunga-e-casuale

# Origini consentite per le richieste CORS (separate da virgola).
# Se omessa, in sviluppo vengono accettate automaticamente le origini
# localhost/127.0.0.1 e gli IP di rete privata (LAN).
CORS_ORIGIN=https://tuo-dominio.it

# Percorsi opzionali dei certificati TLS: se presenti (e i file esistono),
# il backend si avvia in HTTPS invece che in HTTP.
# SSL_KEY_PATH=/etc/letsencrypt/live/tuo-dominio.it/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/tuo-dominio.it/fullchain.pem
